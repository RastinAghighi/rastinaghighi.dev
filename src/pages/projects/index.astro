---
// Projects index. Lists only entries whose frontmatter has `published: true`;
// drafts are never rendered. Each title links to /projects/<entry ID>/, the
// detail page generated by [...id].astro. Plain semantic HTML with no styling:
// the visual design is decided separately.
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects', ({ data }) => data.published === true))
  // Stable order by entry ID until a display order is chosen.
  .sort((a, b) => (a.id < b.id ? -1 : a.id > b.id ? 1 : 0));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Projects</title>
  </head>
  <body>
    <main>
      <h1>Projects</h1>
      {
        projects.length === 0 ? (
          <p>No projects have been published yet.</p>
        ) : (
          <ul>
            {projects.map((project) => (
              <li>
                <article>
                  <h2>
                    <a href={`/projects/${project.id}/`}>{project.data.title}</a>
                  </h2>
                  <p>{project.data.summary}</p>
                </article>
              </li>
            ))}
          </ul>
        )
      }
    </main>
  </body>
</html>
