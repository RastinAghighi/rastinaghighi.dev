---
// Homepage. A static page with no client-side JavaScript and no images yet.
// A dark full-width hero, then a cream editorial section linking to the four
// site sections. The empty .hero-visual element reserves the hero's main area
// for the visual, which is prepared separately. Styles are scoped to this page.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Rastin Aghighi</title>
    <meta name="description" content="The research portfolio of Rastin Aghighi." />
  </head>
  <body>
    <header class="site-header">
      <div class="bar">
        <a class="site-name" href="/" aria-current="page">Rastin Aghighi</a>
        <nav aria-label="Site">
          <ul>
            <li><a href="/projects/">Projects</a></li>
            <li><a href="/papers/">Papers</a></li>
            <li><a href="/notes/">Notes</a></li>
            <li><a href="/about/">About</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-visual" aria-hidden="true"></div>
        <div class="hero-text">
          <h1 id="hero-title">Rastin Aghighi</h1>
          <p class="hero-line">Research portfolio</p>
        </div>
      </section>

      <section class="explore" aria-labelledby="explore-title">
        <div class="explore-inner">
          <h2 id="explore-title">Explore</h2>
          <ul class="explore-list">
            <li><a href="/projects/">Projects<span class="arrow" aria-hidden="true">→</span></a></li>
            <li><a href="/papers/">Papers<span class="arrow" aria-hidden="true">→</span></a></li>
            <li><a href="/notes/">Notes<span class="arrow" aria-hidden="true">→</span></a></li>
            <li><a href="/about/">About<span class="arrow" aria-hidden="true">→</span></a></li>
          </ul>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  /* Palette */
  html {
    --ink: #0b0b0d; /* hero background */
    --ink-text: #f3efe6; /* primary text on the hero */
    --ink-muted: #aaa49a; /* secondary text on the hero */
    --cream: #fef9ed; /* editorial background */
    --brown: #5d524b; /* editorial text */
    --rule: rgba(93, 82, 75, 0.28); /* separators on cream */
    --serif: 'Iowan Old Style', 'Palatino Linotype', Palatino, 'Book Antiqua', Georgia, 'Times New Roman', serif;
    --sans: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    --gutter: clamp(1.25rem, 5vw, 4rem);
    --measure: 84rem;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--cream);
    color: var(--brown);
    font: 1rem/1.55 var(--sans);
  }

  a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
    border-radius: 2px;
  }

  /* Header: part of the dark band; wraps onto two lines on narrow screens. */
  .site-header {
    background: var(--ink);
    color: var(--ink-text);
  }

  .bar {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 1.25rem var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
  }

  .site-name {
    font-family: var(--serif);
    font-size: 1.15rem;
    letter-spacing: 0.01em;
    color: var(--ink-text);
    text-decoration: none;
    padding: 0.4rem 0;
  }

  .site-header ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.75rem;
  }

  .site-header nav a {
    display: inline-block;
    padding: 0.4rem 0;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    color: var(--ink-muted);
    text-decoration: none;
  }

  .site-header nav a:hover {
    color: var(--ink-text);
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 1px;
  }

  /* Hero: most of the first viewport. The visual area takes the free space
     above the title block. */
  .hero {
    background: var(--ink);
    color: var(--ink-text);
    min-height: 82vh;
    min-height: 82svh;
    display: grid;
    grid-template-rows: 1fr auto;
  }

  .hero-visual {
    min-height: 16rem;
  }

  .hero-text {
    width: 100%;
    max-width: var(--measure);
    margin: 0 auto;
    padding: 0 var(--gutter) clamp(3rem, 9vh, 6.5rem);
  }

  .hero h1 {
    margin: 0;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2.75rem, 9vw, 7.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .hero-line {
    margin: 1.25rem 0 0;
    font-size: 0.85rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  /* Editorial section */
  .explore {
    background: var(--cream);
    color: var(--brown);
  }

  .explore-inner {
    max-width: var(--measure);
    margin: 0 auto;
    padding: clamp(4rem, 12vw, 9rem) var(--gutter) clamp(5rem, 14vw, 11rem);
    display: grid;
    gap: 2rem;
  }

  .explore h2 {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .explore-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--rule);
  }

  .explore-list li {
    border-top: 1px solid var(--rule);
  }

  .explore-list a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(1.1rem, 2.6vw, 1.75rem) 0;
    font-family: var(--serif);
    font-size: clamp(1.75rem, 4.2vw, 3rem);
    line-height: 1.1;
    color: var(--brown);
    text-decoration: none;
  }

  .explore-list a:hover {
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }

  .arrow {
    font-family: var(--sans);
    font-size: 0.6em;
  }

  @media (min-width: 52rem) {
    .explore-inner {
      grid-template-columns: minmax(10rem, 1fr) 3fr;
      gap: 3rem;
    }

    .explore h2 {
      padding-top: 0.6rem;
    }
  }
</style>
