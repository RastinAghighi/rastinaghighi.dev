---
// Papers index. Lists only entries whose frontmatter has `published: true`;
// drafts are never rendered. Each title links to /papers/<entry ID>/, the
// detail page generated by [...id].astro. A static page with no client-side
// JavaScript, in the Projects index's warm editorial style: the same cream
// header and navigation, then a label column and a content column. Published
// entries are text rows divided by thin rules; with none, the empty-state
// sentence stands in for the list. The header is not a shared component yet.
// Styles are scoped to this page.
import { getCollection } from 'astro:content';

const papers = (await getCollection('papers', ({ data }) => data.published === true))
  // Stable order by entry ID until a display order is chosen.
  .sort((a, b) => (a.id < b.id ? -1 : a.id > b.id ? 1 : 0));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Papers | Rastin Aghighi</title>
  </head>
  <body>
    <header class="site-header">
      <div class="bar">
        <a class="site-name" href="/">Rastin Aghighi</a>
        <nav aria-label="Site">
          <ul>
            <li><a href="/projects/">Projects</a></li>
            <li><a href="/papers/" aria-current="page">Papers</a></li>
            <li><a href="/notes/">Notes</a></li>
            <li><a href="/about/">About</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <div class="papers">
        <p class="label">Index</p>
        <div class="papers-body">
          <h1>Papers</h1>
          {
            papers.length === 0 ? (
              <p class="empty">No papers have been published yet.</p>
            ) : (
              <ul class="paper-list" role="list">
                {papers.map((paper) => (
                  <li>
                    <article>
                      <h2>
                        <a href={`/papers/${paper.id}/`}>
                          <span class="title">{paper.data.title}</span>
                          <span class="arrow" aria-hidden="true">→</span>
                        </a>
                      </h2>
                      <p class="summary">{paper.data.summary}</p>
                    </article>
                  </li>
                ))}
              </ul>
            )
          }
          <p class="back"><a href="/"><span class="arrow" aria-hidden="true">←</span>Back to home</a></p>
        </div>
      </div>
    </main>
  </body>
</html>

<style>
  /* Palette and type: the Projects and About pages' editorial values. */
  html {
    --cream: #fef9ed; /* background */
    --brown: #5d524b; /* text */
    --rule: rgba(93, 82, 75, 0.28); /* separators on cream */
    --serif: 'Iowan Old Style', 'Palatino Linotype', Palatino, 'Book Antiqua', Georgia, 'Times New Roman', serif;
    --sans: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    --gutter: clamp(1.25rem, 5vw, 4rem);
    --measure: 84rem;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--cream);
    color: var(--brown);
    font: 1rem/1.55 var(--sans);
  }

  a {
    color: var(--brown);
  }

  a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
    border-radius: 2px;
  }

  /* Header: identical to the Projects and About pages'. Wraps onto two lines
     on narrow screens. */
  .site-header {
    background: var(--cream);
  }

  .bar {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 1.25rem var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
  }

  .site-name {
    font-family: var(--serif);
    font-size: 1.15rem;
    letter-spacing: 0.01em;
    text-decoration: none;
    padding: 0.4rem 0;
  }

  .site-header ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.75rem;
  }

  .site-header nav a {
    display: inline-block;
    padding: 0.4rem 0;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    text-decoration: none;
  }

  .site-header nav a:hover,
  .site-header nav a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 1px;
  }

  /* Main content: a label column and a content column on wide screens,
     stacked on narrow ones. Same spacing as the Projects index. */
  .papers {
    max-width: var(--measure);
    margin: 0 auto;
    padding: clamp(4rem, 12vw, 9rem) var(--gutter) clamp(5rem, 14vw, 11rem);
    display: grid;
    gap: 1.5rem;
  }

  /* Grid items default to min-width: auto; this lets long titles wrap
     instead of widening the column. */
  .papers-body {
    min-width: 0;
  }

  .label {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    overflow-wrap: break-word;
    text-wrap: balance;
  }

  /* Empty state: set like the Projects empty state. */
  .empty {
    max-width: 34rem;
    margin: clamp(1.75rem, 4vw, 3rem) 0 0;
    font-size: clamp(1.125rem, 1rem + 0.45vw, 1.375rem);
    line-height: 1.6;
  }

  /* Published entries: full-width rows between thin rules, like the
     Projects index. The title link is the row's one tab stop. Safari and
     VoiceOver drop list semantics when markers are removed, so the markup
     restores them with role="list". */
  .paper-list {
    list-style: none;
    margin: clamp(2.5rem, 6vw, 4.5rem) 0 0;
    padding: 0;
    border-bottom: 1px solid var(--rule);
  }

  .paper-list li {
    border-top: 1px solid var(--rule);
  }

  .paper-list article {
    padding: clamp(1.5rem, 3.2vw, 2.25rem) 0;
  }

  .paper-list h2 {
    margin: 0;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.625rem, 3.4vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .paper-list h2 a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    text-decoration: none;
  }

  .title {
    min-width: 0;
    overflow-wrap: break-word;
    text-wrap: balance;
  }

  .paper-list h2 a:hover .title {
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }

  .paper-list .arrow {
    flex-shrink: 0;
    font-family: var(--sans);
    font-size: 0.6em;
  }

  .summary {
    max-width: 40rem;
    margin: 0.85rem 0 0;
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
    line-height: 1.6;
    overflow-wrap: break-word;
  }

  /* Back link: same treatment as the Projects and About pages. */
  .back {
    max-width: 34rem;
    margin: clamp(3rem, 7vw, 5rem) 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    font-size: 0.95rem;
    letter-spacing: 0.02em;
  }

  /* After a list, the list's closing rule already separates the back link. */
  .paper-list + .back {
    margin-top: clamp(2rem, 5vw, 3.5rem);
    padding-top: 0;
    border-top: 0;
  }

  .back a {
    display: inline-block;
    padding: 0.4rem 0;
    text-decoration: none;
  }

  .back a:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 1px;
  }

  .back .arrow {
    display: inline-block;
    margin-right: 0.6em;
  }

  /* Same breakpoint and columns as the Projects index. The label sits on the
     heading's first baseline. */
  @media (min-width: 52rem) {
    .papers {
      grid-template-columns: minmax(10rem, 1fr) 3fr;
      align-items: baseline;
      gap: 3rem;
    }
  }
</style>
