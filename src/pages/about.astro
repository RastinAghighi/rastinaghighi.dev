---
// About page. A static page with no client-side JavaScript. It uses the warm
// editorial palette of the homepage's Explore section: a cream header with the
// site navigation, then a short introduction. The header and type follow the
// homepage's conventions; it is not a shared component yet. Styles are scoped
// to this page.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>About | Rastin Aghighi</title>
  </head>
  <body>
    <header class="site-header">
      <div class="bar">
        <a class="site-name" href="/">Rastin Aghighi</a>
        <nav aria-label="Site">
          <ul>
            <li><a href="/projects/">Projects</a></li>
            <li><a href="/papers/">Papers</a></li>
            <li><a href="/notes/">Notes</a></li>
            <li><a href="/about/" aria-current="page">About</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <div class="about">
        <p class="label">About</p>
        <div class="about-body">
          <h1>Rastin Aghighi</h1>
          <p class="intro">I'm Rastin Aghighi. I'll share more about my background and research here soon.</p>
          <p class="back"><a href="/"><span class="arrow" aria-hidden="true">←</span>Back to home</a></p>
        </div>
      </div>
    </main>
  </body>
</html>

<style>
  /* Palette and type: the homepage's editorial values. */
  html {
    --cream: #fef9ed; /* background */
    --brown: #5d524b; /* text */
    --rule: rgba(93, 82, 75, 0.28); /* separators on cream */
    --serif: 'Iowan Old Style', 'Palatino Linotype', Palatino, 'Book Antiqua', Georgia, 'Times New Roman', serif;
    --sans: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    --gutter: clamp(1.25rem, 5vw, 4rem);
    --measure: 84rem;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--cream);
    color: var(--brown);
    font: 1rem/1.55 var(--sans);
  }

  a {
    color: var(--brown);
  }

  a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
    border-radius: 2px;
  }

  /* Header: same layout as the homepage, in the light palette. Wraps onto two
     lines on narrow screens. */
  .site-header {
    background: var(--cream);
  }

  .bar {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 1.25rem var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
  }

  .site-name {
    font-family: var(--serif);
    font-size: 1.15rem;
    letter-spacing: 0.01em;
    text-decoration: none;
    padding: 0.4rem 0;
  }

  .site-header ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.75rem;
  }

  .site-header nav a {
    display: inline-block;
    padding: 0.4rem 0;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    text-decoration: none;
  }

  .site-header nav a:hover,
  .site-header nav a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 1px;
  }

  /* Introduction: a label column and a text column on wide screens, stacked
     on narrow ones. */
  .about {
    max-width: var(--measure);
    margin: 0 auto;
    padding: clamp(4rem, 12vw, 9rem) var(--gutter) clamp(5rem, 14vw, 11rem);
    display: grid;
    gap: 1.5rem;
  }

  .label {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    overflow-wrap: break-word;
    text-wrap: balance;
  }

  .intro {
    max-width: 34rem;
    margin: clamp(1.75rem, 4vw, 3rem) 0 0;
    font-size: clamp(1.125rem, 1rem + 0.45vw, 1.375rem);
    line-height: 1.6;
  }

  .back {
    max-width: 34rem;
    margin: clamp(3rem, 7vw, 5rem) 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    font-size: 0.95rem;
    letter-spacing: 0.02em;
  }

  .back a {
    display: inline-block;
    padding: 0.4rem 0;
    text-decoration: none;
  }

  .back a:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 1px;
  }

  .arrow {
    display: inline-block;
    margin-right: 0.6em;
  }

  /* Same breakpoint and columns as the homepage's Explore section. The label
     sits on the heading's first baseline. */
  @media (min-width: 52rem) {
    .about {
      grid-template-columns: minmax(10rem, 1fr) 3fr;
      align-items: baseline;
      gap: 3rem;
    }
  }
</style>
