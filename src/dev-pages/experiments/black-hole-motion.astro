---
// Isolated visual experiment, not linked from the site: can the approved
// black-hole still be animated convincingly with a WebGL fragment shader?
// Left: the untouched image. Right: the same image, re-sampled every frame
// along orbital paths around a fixed shadow. No libraries; the shader and its
// setup live in the <script> below. Styles are scoped to this page.
const source = '/media/coral-peach-strong-shader-source.webp';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Black-hole motion (experiment) | Rastin Aghighi</title>
  </head>
  <body>
    <main>
      <header class="intro">
        <p class="label">Experiment</p>
        <h1>Black-hole motion</h1>
        <p>
          The approved still (left) next to a WebGL shader animation of the same image (right). The shader
          moves the accretion disk and surrounding plasma along orbits around a fixed shadow. It is a visual
          approximation built from one still image, not a 3D simulation, and it does not reproduce the
          original animation.
        </p>
      </header>

      <div class="compare">
        <figure>
          <img src={source} width="1280" height="720" alt="Black hole with a coral-peach dithered accretion disk, static." />
          <figcaption>Static original</figcaption>
        </figure>
        <figure class="animated" data-state="loading">
          <canvas
            id="bh-canvas"
            width="1280"
            height="720"
            role="img"
            aria-label="The same black hole, with the accretion disk slowly orbiting the stationary shadow."
          ></canvas>
          <img class="fallback" src={source} width="1280" height="720" alt="" hidden />
          <figcaption>Shader animation</figcaption>
        </figure>
      </div>

      <form class="controls" aria-label="Animation controls">
        <div class="control">
          <label for="bh-speed">Animation speed</label>
          <input id="bh-speed" type="range" min="0.25" max="3" step="0.05" value="1" />
          <output id="bh-speed-out" for="bh-speed">1.00×</output>
        </div>
        <div class="control">
          <label for="bh-strength">Motion strength</label>
          <input id="bh-strength" type="range" min="0" max="2" step="0.05" value="1" />
          <output id="bh-strength-out" for="bh-strength">1.00×</output>
        </div>
        <div class="control control-button">
          <button id="bh-toggle" type="button">Pause</button>
          <span id="bh-clock" class="clock">0.0 s / 12 s</span>
        </div>
      </form>
      <p id="bh-status" class="status" role="status"></p>

      <section class="notes" aria-labelledby="notes-title">
        <h2 id="notes-title">How it works</h2>
        <ul>
          <li>
            Every output pixel is copied unchanged from the source image, in whole 2×2 dither cells. No colours
            are blended or invented, so the coral-peach palette and dithering stay exactly as approved.
          </li>
          <li>
            The shadow is found in the image itself (the connected dark region around the centre) and is never
            re-sampled. Motion fades out within about 40&nbsp;px of it, so the silhouette and the thin ring
            hugging it stay put.
          </li>
          <li>
            Plasma drifts counter-clockwise on screen: flattened ellipses for the disk (left to right in front
            of the shadow), circles for the lensed arc (right to left over the top). Inner orbits move faster
            than outer ones.
          </li>
          <li>
            Two copies of the image drift forward and dissolve into each other cell by cell, so the motion
            never reverses. Six 2-second cycles plus a slow 12-second variation give an exact 12-second loop.
          </li>
        </ul>
      </section>
    </main>
  </body>
</html>

<script>
  const SOURCE = '/media/coral-peach-strong-shader-source.webp';
  // The shader's geometry was measured on this exact 1280×720 image.
  const WIDTH = 1280;
  const HEIGHT = 720;
  const LOOP_SECONDS = 12;
  // Displacement per 2 s flow cycle at the fastest point, at strength 1
  // (about 7 px/s). Short cycles keep the two flow layers similar, so the
  // dither texture stays as crisp as the original.
  const BASE_SHIFT_PX = 14;
  // Shadow: a circle centred at (640, 361) with radius about 199 px. Flood fill
  // starts above and below the disk band that crosses in front of it.
  const SHADOW_CENTRE = [640, 361];
  const SHADOW_RADIUS = 199;
  const SHADOW_SEEDS = [
    [640, 270],
    [640, 530],
  ];

  const VERTEX_SHADER = `
attribute vec2 aPosition;
void main() {
  gl_Position = vec4(aPosition, 0.0, 1.0);
}`;

  const FRAGMENT_SHADER = `
precision highp float;

uniform sampler2D uImage;    // source image, nearest filtering
uniform sampler2D uCellDist; // per 2x2 cell: distance to the shadow in px (0 = shadow)
uniform vec2 uSize;          // image size in px
uniform float uLoop;         // position in the 12 s loop, 0..1
uniform float uShift;        // px moved per flow cycle at the fastest point; 0 = still

const vec2 CENTRE = vec2(640.0, 361.0); // shadow centre, image px
const float INCLINATION = 0.22;          // disk orbits seen as ellipses of this aspect
const float INNER = 220.0;               // radius where speed is normalised to 1
const float CYCLES = 6.0;                // flow cycles per loop (2 s each at 1x)
const float TWO_PI = 6.28318530718;

float hash12(vec2 p) {
  vec3 p3 = fract(vec3(p.xyx) * 0.1031);
  p3 += dot(p3, p3.yzx + 33.33);
  return fract((p3.x + p3.y) * p3.z);
}

float valueNoise(vec2 p) {
  vec2 i = floor(p);
  vec2 f = fract(p);
  vec2 u = f * f * (3.0 - 2.0 * f);
  return mix(mix(hash12(i), hash12(i + vec2(1.0, 0.0)), u.x),
             mix(hash12(i + vec2(0.0, 1.0)), hash12(i + vec2(1.0, 1.0)), u.x), u.y);
}

// Orbital velocity at offset d from the centre (y up), counter-clockwise on
// screen. The disk uses flattened ellipses; the lensed arc above the shadow
// uses circles. Angular speed falls off as r^-1.5, like Kepler orbits.
vec2 orbitVelocity(vec2 d) {
  float re = max(length(vec2(d.x, d.y / INCLINATION)), INNER);
  vec2 disk = pow(re / INNER, -1.5) * vec2(-d.y / INCLINATION, INCLINATION * d.x);
  float rc = length(d);
  vec2 ring = pow(max(rc, INNER) / INNER, -1.5) * vec2(-d.y, d.x);
  float arc = (1.0 - smoothstep(330.0, 470.0, rc)) * smoothstep(-30.0, 30.0, d.y);
  return mix(disk, ring, arc) / INNER;
}

// Mirror out-of-range pixel coordinates back into the image.
vec2 mirrorPx(vec2 p) {
  vec2 m = mod(p, 2.0 * uSize);
  return mix(m, 2.0 * uSize - 1.0 - m, step(uSize, m));
}

float cellDist(vec2 cell) {
  return texture2D(uCellDist, (cell + 0.5) / (uSize * 0.5)).r * 255.0;
}

void main() {
  vec2 px = floor(vec2(gl_FragCoord.x, uSize.y - gl_FragCoord.y));
  vec4 original = texture2D(uImage, (px + 0.5) / uSize);
  vec2 cell = floor(px * 0.5);
  float dist = cellDist(cell);
  if (uShift <= 0.0 || dist < 0.5) {
    gl_FragColor = original;
    return;
  }

  // Work per dither cell so the 2x2 structure survives.
  vec2 c = cell * 2.0 + 1.0;
  vec2 v = orbitVelocity(vec2(c.x - CENTRE.x, CENTRE.y - c.y));
  vec2 shift = vec2(v.x, -v.y) * uShift * smoothstep(4.0, 40.0, dist);

  // Flow map: two layers drift forward, each restarting while invisible.
  // Spatial noise staggers the restarts; the sine term varies the pace by
  // about 10% over 12 s without ever reversing it (6 - 2pi * 0.1 > 0).
  float tau = CYCLES * uLoop + valueNoise(c / 360.0)
            + 0.1 * sin(TWO_PI * (uLoop + valueNoise(c / 300.0 + 11.0)));
  float phaseA = fract(tau);
  float phaseB = fract(tau + 0.5);
  float weightB = abs(2.0 * phaseA - 1.0);
  float phase = (0.001 + 0.998 * hash12(cell)) < weightB ? phaseB : phaseA;

  // Sample upstream, never reaching into the shadow.
  vec2 offset = shift * (phase - 0.5);
  float maxLen = max(0.0, 0.9 * dist - 3.0);
  float len = length(offset);
  if (len > maxLen) offset *= maxLen / len;

  vec2 src = mirrorPx(px - 2.0 * floor(offset * 0.5 + 0.5));
  if (cellDist(floor(src * 0.5)) < 0.5) {
    gl_FragColor = original;
    return;
  }
  gl_FragColor = texture2D(uImage, (src + 0.5) / uSize);
}`;

  const figure = document.querySelector<HTMLElement>('.animated')!;
  const canvas = document.getElementById('bh-canvas') as HTMLCanvasElement;
  const fallback = figure.querySelector<HTMLImageElement>('.fallback')!;
  const speedInput = document.getElementById('bh-speed') as HTMLInputElement;
  const speedOut = document.getElementById('bh-speed-out') as HTMLOutputElement;
  const strengthInput = document.getElementById('bh-strength') as HTMLInputElement;
  const strengthOut = document.getElementById('bh-strength-out') as HTMLOutputElement;
  const toggle = document.getElementById('bh-toggle') as HTMLButtonElement;
  const clock = document.getElementById('bh-clock')!;
  const status = document.getElementById('bh-status')!;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelector('.controls')!.addEventListener('submit', (event) => event.preventDefault());

  // Distance from each 2x2 cell to the shadow, in px (0 = shadow cell),
  // clamped to 255. The shadow is the dark region connected to the seeds,
  // limited to a circle slightly larger than the silhouette.
  function shadowCellDistance(pixels: Uint8ClampedArray): Uint8Array {
    const isDark = (i: number) =>
      0.2126 * pixels[i * 4] + 0.7152 * pixels[i * 4 + 1] + 0.0722 * pixels[i * 4 + 2] < 30;
    const limit = (SHADOW_RADIUS * 1.06) ** 2;
    const nearShadow = (x: number, y: number) =>
      (x - SHADOW_CENTRE[0]) ** 2 + (y - SHADOW_CENTRE[1]) ** 2 <= limit;

    const shadow = new Uint8Array(WIDTH * HEIGHT);
    const stack: number[] = [];
    for (const [x, y] of SHADOW_SEEDS) {
      const i = y * WIDTH + x;
      if (isDark(i)) {
        shadow[i] = 1;
        stack.push(i);
      }
    }
    while (stack.length > 0) {
      const i = stack.pop()!;
      const x = i % WIDTH;
      const y = (i - x) / WIDTH;
      const neighbours: [number, number][] = [
        [x - 1, y],
        [x + 1, y],
        [x, y - 1],
        [x, y + 1],
      ];
      for (const [nx, ny] of neighbours) {
        if (nx < 0 || ny < 0 || nx >= WIDTH || ny >= HEIGHT) continue;
        const j = ny * WIDTH + nx;
        if (!shadow[j] && nearShadow(nx, ny) && isDark(j)) {
          shadow[j] = 1;
          stack.push(j);
        }
      }
    }

    const cw = WIDTH / 2;
    const ch = HEIGHT / 2;
    const dist = new Float32Array(cw * ch).fill(1e6);
    for (let cy = 0; cy < ch; cy++) {
      for (let cx = 0; cx < cw; cx++) {
        const p = cy * 2 * WIDTH + cx * 2;
        if (shadow[p] || shadow[p + 1] || shadow[p + WIDTH] || shadow[p + WIDTH + 1]) dist[cy * cw + cx] = 0;
      }
    }
    // Two-pass chamfer distance transform (steps of 1 and √2 cells).
    const d2 = Math.SQRT2;
    const at = (x: number, y: number) => (x < 0 || y < 0 || x >= cw || y >= ch ? 1e6 : dist[y * cw + x]);
    for (let y = 0; y < ch; y++) {
      for (let x = 0; x < cw; x++) {
        const i = y * cw + x;
        dist[i] = Math.min(dist[i], at(x - 1, y) + 1, at(x, y - 1) + 1, at(x - 1, y - 1) + d2, at(x + 1, y - 1) + d2);
      }
    }
    for (let y = ch - 1; y >= 0; y--) {
      for (let x = cw - 1; x >= 0; x--) {
        const i = y * cw + x;
        dist[i] = Math.min(dist[i], at(x + 1, y) + 1, at(x, y + 1) + 1, at(x + 1, y + 1) + d2, at(x - 1, y + 1) + d2);
      }
    }
    const out = new Uint8Array(cw * ch);
    for (let i = 0; i < out.length; i++) out[i] = Math.min(255, Math.round(dist[i] * 2));
    return out;
  }

  function compile(gl: WebGLRenderingContext, type: number, source: string): WebGLShader {
    const shader = gl.createShader(type)!;
    gl.shaderSource(shader, source);
    gl.compileShader(shader);
    if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
      throw new Error(gl.getShaderInfoLog(shader) || 'Shader compile failed');
    }
    return shader;
  }

  function texture(gl: WebGLRenderingContext, unit: number): WebGLTexture {
    const tex = gl.createTexture()!;
    gl.activeTexture(gl.TEXTURE0 + unit);
    gl.bindTexture(gl.TEXTURE_2D, tex);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.NEAREST);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.NEAREST);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
    return tex;
  }

  function showFallback(message: string) {
    figure.dataset.state = 'fallback';
    canvas.hidden = true;
    fallback.hidden = false;
    fallback.alt = 'Black hole, static (animation unavailable).';
    for (const control of [speedInput, strengthInput, toggle]) control.disabled = true;
    status.textContent = message;
  }

  async function start() {
    const image = new Image();
    image.src = SOURCE;
    await image.decode();
    if (image.naturalWidth !== WIDTH || image.naturalHeight !== HEIGHT) {
      throw new Error(`Expected a ${WIDTH}×${HEIGHT} image`);
    }

    const scratch = document.createElement('canvas');
    scratch.width = WIDTH;
    scratch.height = HEIGHT;
    const ctx = scratch.getContext('2d', { willReadFrequently: true })!;
    ctx.drawImage(image, 0, 0);
    const cellDistance = shadowCellDistance(ctx.getImageData(0, 0, WIDTH, HEIGHT).data);

    const gl = canvas.getContext('webgl', {
      alpha: false,
      antialias: false,
      depth: false,
      stencil: false,
      premultipliedAlpha: false,
      powerPreference: 'low-power',
    });
    if (!gl) throw new Error('WebGL unavailable');
    const highp = gl.getShaderPrecisionFormat(gl.FRAGMENT_SHADER, gl.HIGH_FLOAT);
    if (!highp || highp.precision === 0) throw new Error('High-precision shaders unavailable');

    const program = gl.createProgram()!;
    gl.attachShader(program, compile(gl, gl.VERTEX_SHADER, VERTEX_SHADER));
    gl.attachShader(program, compile(gl, gl.FRAGMENT_SHADER, FRAGMENT_SHADER));
    gl.linkProgram(program);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
      throw new Error(gl.getProgramInfoLog(program) || 'Shader link failed');
    }
    gl.useProgram(program);

    // One triangle that covers the whole canvas.
    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const position = gl.getAttribLocation(program, 'aPosition');
    gl.enableVertexAttribArray(position);
    gl.vertexAttribPointer(position, 2, gl.FLOAT, false, 0, 0);

    texture(gl, 0);
    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, image);
    texture(gl, 1);
    gl.pixelStorei(gl.UNPACK_ALIGNMENT, 1);
    gl.texImage2D(gl.TEXTURE_2D, 0, gl.LUMINANCE, WIDTH / 2, HEIGHT / 2, 0, gl.LUMINANCE, gl.UNSIGNED_BYTE, cellDistance);

    gl.uniform1i(gl.getUniformLocation(program, 'uImage'), 0);
    gl.uniform1i(gl.getUniformLocation(program, 'uCellDist'), 1);
    gl.uniform2f(gl.getUniformLocation(program, 'uSize'), WIDTH, HEIGHT);
    const uLoop = gl.getUniformLocation(program, 'uLoop');
    const uShift = gl.getUniformLocation(program, 'uShift');
    gl.viewport(0, 0, WIDTH, HEIGHT);

    // Reduced motion: show the untouched image until the viewer presses Play.
    let still = reducedMotion.matches;
    let playing = !still;
    let loopTime = 0; // seconds into the loop
    let last = 0;
    let raf = 0;

    function draw() {
      gl!.uniform1f(uLoop, loopTime / LOOP_SECONDS);
      gl!.uniform1f(uShift, still ? 0 : Number(strengthInput.value) * BASE_SHIFT_PX);
      gl!.drawArrays(gl!.TRIANGLES, 0, 3);
      clock.textContent = `${loopTime.toFixed(1)} s / ${LOOP_SECONDS} s`;
    }

    function frame(now: number) {
      const dt = last ? Math.min((now - last) / 1000, 0.1) : 0;
      last = now;
      loopTime = (loopTime + dt * Number(speedInput.value)) % LOOP_SECONDS;
      draw();
      raf = requestAnimationFrame(frame);
    }

    function update() {
      toggle.textContent = playing ? 'Pause' : 'Play';
      figure.dataset.state = still ? 'still' : playing ? 'playing' : 'paused';
      status.textContent = still
        ? 'Reduced motion is on, so the still image is shown. Press Play to preview the animation.'
        : '';
    }

    function play() {
      still = false;
      playing = true;
      last = 0;
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(frame);
      update();
    }

    function pause() {
      playing = false;
      cancelAnimationFrame(raf);
      draw();
      update();
    }

    toggle.addEventListener('click', () => (playing ? pause() : play()));
    speedInput.addEventListener('input', () => {
      speedOut.textContent = `${Number(speedInput.value).toFixed(2)}×`;
    });
    strengthInput.addEventListener('input', () => {
      strengthOut.textContent = `${Number(strengthInput.value).toFixed(2)}×`;
      if (!playing) draw();
    });
    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches) {
        pause();
        still = true;
        draw();
        update();
      }
    });
    canvas.addEventListener('webglcontextlost', (event) => {
      event.preventDefault();
      cancelAnimationFrame(raf);
      showFallback('The WebGL context was lost, so the still image is shown. Reload to try again.');
    });

    update();
    if (playing) play();
    else draw();
  }

  start().catch((error) => {
    console.error(error);
    showFallback('The animation could not start in this browser, so the still image is shown.');
  });
</script>

<style>
  html {
    --ink: #0b0b0d;
    --ink-text: #f3efe6;
    --ink-muted: #aaa49a;
    --rule: rgba(243, 239, 230, 0.16);
    --accent: #f4b49a;
    --serif: 'Iowan Old Style', 'Palatino Linotype', Palatino, 'Book Antiqua', Georgia, 'Times New Roman', serif;
    --sans: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    --gutter: clamp(1.25rem, 4vw, 3rem);
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--ink);
    color: var(--ink-text);
    font: 1rem/1.55 var(--sans);
  }

  main {
    max-width: 96rem;
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 3rem) var(--gutter) 4rem;
  }

  .intro {
    max-width: 46rem;
  }

  .label {
    margin: 0;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  h1 {
    margin: 0.35rem 0 0.75rem;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1.1;
  }

  .intro p:last-child {
    margin: 0;
    color: var(--ink-muted);
  }

  .compare {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
    gap: 1.25rem;
    margin: 2rem 0 1.5rem;
  }

  figure {
    margin: 0;
  }

  figure img,
  figure canvas {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    background: #0a0a0c;
  }

  figure img[hidden],
  figure canvas[hidden] {
    display: none;
  }

  figcaption {
    margin-top: 0.6rem;
    font-size: 0.9rem;
    color: var(--ink-muted);
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2.5rem;
    padding: 1rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .control {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .control label {
    font-size: 0.95rem;
  }

  .control input[type='range'] {
    width: 10rem;
    accent-color: var(--accent);
  }

  .control output,
  .clock {
    min-width: 4.5rem;
    font-variant-numeric: tabular-nums;
    font-size: 0.9rem;
    color: var(--ink-muted);
  }

  button {
    min-width: 5.5rem;
    padding: 0.45rem 1rem;
    font: inherit;
    font-size: 0.95rem;
    color: var(--ink);
    background: var(--ink-text);
    border: 1px solid var(--ink-text);
    border-radius: 2px;
    cursor: pointer;
  }

  button:hover {
    background: var(--accent);
    border-color: var(--accent);
  }

  button:disabled,
  input:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  button:focus-visible,
  input:focus-visible {
    outline: 2px solid var(--ink-text);
    outline-offset: 3px;
  }

  .status {
    min-height: 1.55em;
    margin: 0.75rem 0 0;
    font-size: 0.9rem;
    color: var(--accent);
  }

  .notes {
    max-width: 46rem;
    margin-top: 2.5rem;
  }

  h2 {
    margin: 0 0 0.75rem;
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.4rem;
  }

  .notes ul {
    margin: 0;
    padding-left: 1.2rem;
    color: var(--ink-muted);
  }

  .notes li + li {
    margin-top: 0.5rem;
  }
</style>
