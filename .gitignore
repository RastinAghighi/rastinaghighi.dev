# .gitignore for rastinaghighi.dev
#
# Reminder: .gitignore only stops *untracked* files from being added.
# It does not protect a file that is already tracked or that already exists
# in Git history. Review `git status` and the staged diff before every commit.

# ---------------------------------------------------------------------------
# Private planning documents: local only, never publish.
# Root-anchored and specific to these two documents. The trailing `*` also
# covers numbered or renamed copies such as "backend-master-plan (1).md",
# "rastinaghighi.dev Design Plan (4).pdf", "... - Copy.md", OneDrive conflict
# copies and exports to other formats. Public documentation elsewhere in the
# repository remains trackable.
# ---------------------------------------------------------------------------
/backend-master-plan*
/rastinaghighi.dev Design Plan*

# ---------------------------------------------------------------------------
# Environment and secret files (any directory).
# Only an intentionally reviewed .env.example may be committed.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# Cloudflare Wrangler local secrets, including per-environment variants
.dev.vars
.dev.vars.*

# Private keys and certificate bundles
*.pem
*.key
*.p12
*.pfx

# ---------------------------------------------------------------------------
# Local tool state
# ---------------------------------------------------------------------------
# Wrangler / Miniflare local state
.wrangler/

# Claude Code personal settings (can contain local file paths)
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Node / Astro dependencies and build output
# ---------------------------------------------------------------------------
node_modules/
dist/
.astro/
coverage/

# ---------------------------------------------------------------------------
# Caches and logs
# ---------------------------------------------------------------------------
.cache/
.eslintcache
*.tsbuildinfo
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Python (only relevant if local utility scripts are added later)
# ---------------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# Operating system and editor files
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
